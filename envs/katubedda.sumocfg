<configuration>
    <input>
        <net-file value="katubedda.net.xml"/>
        <route-files value="katubedda.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1.0"/>
    </time>
    <processing>
        <!-- Teleport vehicles after 300 seconds of total gridlock to keep the simulation alive if queues blow up -->
        <time-to-teleport value="300"/>
        <collision.action value="none"/>
    </processing>
    <gui_only>
        <delay value="50"/>
        <start value="true"/>
    </gui_only>
</configuration>